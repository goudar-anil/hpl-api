
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String    @map("full_name") @db.VarChar(100)
  phone              String    @unique @db.VarChar(10)
  dob                DateTime  @db.Date
  playingRole        String    @map("playing_role") @db.VarChar(20)
  village            String    @db.VarChar(100)
  photoPath          String?   @map("photo_path")
  registrationStatus String    @default("PENDING_REVIEW") @map("registration_status") @db.VarChar(20)

  // Payment tracking
  paymentStatus      String    @default("NOT_SUBMITTED") @map("payment_status") @db.VarChar(20)
  paymentAmount      Int       @default(5000) @map("payment_amount")
  paymentProofPath   String?   @map("payment_proof_path")
  paymentSubmittedAt DateTime? @map("payment_submitted_at") @db.Timestamptz(6)
  paymentVerifiedAt  DateTime? @map("payment_verified_at") @db.Timestamptz(6)

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("player")
}